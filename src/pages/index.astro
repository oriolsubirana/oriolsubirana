---
import { Image } from "astro:assets";
import portrait from "../assets/images/photo2.png";
import experiences from "../collections/experiences.json";
import focus from "../collections/focus.json";
import Button from "../components/button.astro";
import Layout from "../layouts/main.astro";

const RESUME_URL = "/OriolSubirana2026-SWE.pdf";
const current = experiences[0];
---

<Layout title="Oriol Subirana">
  <section class="relative overflow-hidden">
    <div class="grid-backdrop pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <div
      class="mx-auto grid w-full max-w-5xl items-center gap-12 px-6 pb-16 pt-14 md:grid-cols-[1.15fr_1fr] md:pb-24 md:pt-20 lg:gap-16"
    >
      <div>
        <h1
          class="text-5xl font-semibold leading-[1.02] tracking-[-0.03em] text-stone-900 dark:text-stone-50 sm:text-6xl lg:text-7xl"
        >
          Hello,<br />I'm Oriol.
        </h1>
        <p class="mt-7 max-w-md text-lg leading-8 text-stone-600 dark:text-stone-400">
          Software engineer lead in Zürich. For over ten years I've built
          cloud platforms in Java and Kotlin and led the teams that run them.
          Lately, the backends behind enterprise AI.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <Button text="Read my résumé" link={RESUME_URL} external />
          <Button text="Get in touch" link="/about#connect" variant="secondary" />
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-sm md:max-w-none">
        <div
          class="relative rounded-3xl border border-dashed border-stone-300 bg-gradient-to-b from-stone-100 to-stone-50 px-8 pt-8 dark:border-stone-700 dark:from-stone-900 dark:to-stone-950"
        >
          <Image
            src={portrait}
            alt="Oriol Subirana in cycling kit, standing beside his road bike"
            widths={[360, 540, 720]}
            sizes="(min-width: 768px) 28rem, 90vw"
            loading="eager"
            class="mx-auto block w-full max-w-xs md:max-w-sm"
          />
          <span
            class="absolute -left-4 top-10 flex h-12 w-12 items-center justify-center rounded-full border border-dashed border-stone-300 bg-stone-50 text-xl shadow-sm dark:border-stone-700 dark:bg-stone-950"
            aria-hidden="true"
          >
            👋
          </span>
        </div>
      </div>
    </div>
  </section>

  <section
    aria-labelledby="focus-heading"
    class="border-t border-stone-200 dark:border-stone-800"
  >
    <div class="mx-auto w-full max-w-5xl px-6 py-16 md:py-20">
      <h2
        id="focus-heading"
        class="text-2xl font-semibold tracking-tight text-stone-900 dark:text-stone-50"
      >
        What I do
      </h2>
      <div class="mt-10 grid gap-10 sm:grid-cols-2 sm:gap-x-12 md:gap-x-16 md:gap-y-12">
        {
          focus.map((item) => (
            <div>
              <h3 class="text-base font-semibold text-stone-900 dark:text-stone-100">
                {item.title}
              </h3>
              <p class="mt-3 max-w-prose text-base leading-7 text-stone-600 dark:text-stone-400">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    aria-labelledby="now-heading"
    class="border-t border-stone-200 dark:border-stone-800"
  >
    <div
      class="mx-auto grid w-full max-w-5xl gap-8 px-6 py-16 md:grid-cols-[1fr_2fr] md:py-20"
    >
      <h2
        id="now-heading"
        class="text-2xl font-semibold tracking-tight text-stone-900 dark:text-stone-50"
      >
        Now
      </h2>
      <div class="max-w-prose">
        <p class="text-lg leading-8 text-stone-700 dark:text-stone-300">
          {current.role} at {current.company}, since {current.start}.
        </p>
        <p class="mt-4 text-base leading-7 text-stone-600 dark:text-stone-400">
          {current.description}
        </p>
        <p class="mt-6">
          <a href="/about" class="link-underline text-base font-medium text-stone-900 dark:text-stone-100">
            The full story, and what I'm up to off the keyboard
          </a>
        </p>
      </div>
    </div>
  </section>
</Layout>
