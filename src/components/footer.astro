---
import social from "../collections/social.json";
import Logo from "./logo.astro";
import SocialIcon from "./social-icon.astro";

type IconName = "mail" | "linkedin" | "github" | "x" | "instagram";
const year = new Date().getFullYear();
---

<footer class="border-t border-stone-200 dark:border-stone-800">
  <div
    class="mx-auto flex w-full max-w-5xl flex-col gap-6 px-6 py-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
      <Logo />
      <p class="text-sm text-stone-500 dark:text-stone-400">
        © {year} Oriol Subirana. Zürich, Switzerland.
      </p>
    </div>

    <ul class="flex items-center gap-1">
      {
        social.map((item) => (
          <li>
            <a
              href={item.url}
              target={item.url.startsWith("http") ? "_blank" : undefined}
              rel={item.url.startsWith("http") ? "noopener noreferrer" : undefined}
              class="inline-flex h-9 w-9 items-center justify-center rounded-full text-stone-500 transition-colors hover:bg-stone-200/60 hover:text-stone-900 dark:text-stone-400 dark:hover:bg-stone-800/60 dark:hover:text-stone-100"
            >
              <span class="sr-only">{item.name}</span>
              <SocialIcon name={item.icon as IconName} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
