---
import menus from "../collections/menu.json";
import Logo from "./logo.astro";
import ThemeToggle from "./theme-toggle.astro";
---

<header
  class="sticky top-0 z-50 border-b border-stone-200/70 bg-stone-50/80 backdrop-blur-md dark:border-stone-800/70 dark:bg-stone-950/80"
>
  <div class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-6">
    <Logo />

    <nav aria-label="Main" class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 sm:flex">
        {
          menus.map((menu) => (
            <li>
              <a
                href={menu.url}
                data-nav-link
                class="group relative rounded-full px-3 py-1.5 text-sm font-medium text-stone-600 transition-colors hover:text-stone-900 aria-[current=page]:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100 dark:aria-[current=page]:text-stone-100"
              >
                {menu.name}
                <span
                  aria-hidden="true"
                  class="absolute -bottom-0.5 left-1/2 h-1 w-1 -translate-x-1/2 rounded-full bg-accent opacity-0 transition-opacity group-aria-[current=page]:opacity-100"
                />
              </a>
            </li>
          ))
        }
      </ul>

      <ThemeToggle />

      <button
        id="menu-toggle"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
        class="ml-1 inline-flex h-9 w-9 items-center justify-center rounded-full text-stone-700 hover:bg-stone-200/60 dark:text-stone-300 dark:hover:bg-stone-800/60 sm:hidden"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </nav>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-stone-200/70 px-6 py-3 dark:border-stone-800/70 sm:hidden"
  >
    <ul class="flex flex-col">
      {
        menus.map((menu) => (
          <li>
            <a
              href={menu.url}
              data-nav-link
              class="block rounded-lg px-2 py-2.5 text-base font-medium text-stone-600 aria-[current=page]:text-stone-900 dark:text-stone-400 dark:aria-[current=page]:text-stone-100"
            >
              {menu.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
