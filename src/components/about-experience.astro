---
interface Props {
	logo: string;
	start: string;
	end: string;
	role: string;
	company: string;
	description: string;
	last?: boolean;
}

const {
	logo,
	start,
	end,
	role,
	company,
	description,
	last = false,
} = Astro.props;
---

<li class="relative grid gap-3 md:grid-cols-[10rem_1fr] md:gap-8">
  <p class="pt-3 text-sm text-stone-500 dark:text-stone-400 md:whitespace-nowrap md:text-right">{start} – {end}</p>

  <div class:list={["relative pl-14 pb-10", !last && "border-l border-stone-200 dark:border-stone-800"]}>
    <span
      class="absolute left-0 top-0 flex h-11 w-11 -translate-x-1/2 items-center justify-center rounded-full border border-stone-200 bg-white dark:border-stone-700 dark:bg-stone-100"
    >
      <img
        src={logo}
        alt=""
        width="24"
        height="24"
        loading="lazy"
        class="h-6 w-6 rounded-full object-contain"
      />
    </span>
    <h3 class="pt-2 text-lg font-semibold tracking-tight text-stone-900 dark:text-stone-50">
      {role}
    </h3>
    <p class="mt-0.5 text-sm font-medium text-stone-700 dark:text-stone-300">{company}</p>
    <p class="mt-3 max-w-prose text-base leading-7 text-stone-600 dark:text-stone-400">
      {description}
    </p>
  </div>
</li>
