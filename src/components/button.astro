---
interface Props {
	link: string;
	text: string;
	variant?: "primary" | "secondary";
	external?: boolean;
}

const { link, text, variant = "primary", external = false } = Astro.props;

const base =
	"inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-medium transition-colors";
const variants = {
	primary:
		"bg-stone-900 text-stone-50 hover:bg-stone-700 dark:bg-stone-100 dark:text-stone-900 dark:hover:bg-white",
	secondary:
		"border border-stone-300 text-stone-800 hover:border-stone-900 hover:bg-stone-100 dark:border-stone-700 dark:text-stone-200 dark:hover:border-stone-300 dark:hover:bg-stone-900",
};
---

<a
  href={link}
  class:list={[base, variants[variant]]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  {text}
  {external && <span class="sr-only"> (opens in a new tab)</span>}
</a>
